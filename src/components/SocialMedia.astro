---
const { platform, username } = Astro.props;
---

<a
    href={`https://www.${platform}.com/${username}`}
    target="_blank"
    rel="noopener noreferrer"
>
    {platform} @{username}
</a>

<style>
    a {
        padding: 0.4rem 0.8rem;
        color: #fff;
        background-color: #333;
        text-decoration: none;
        border-radius: 4px;
        font-size: 0.85rem;
        transition: opacity 0.2s ease;
    }

    a:hover {
        opacity: 0.7;
    }
</style>
