---
interface Props {
    url: string;
    title: string;
    description: string;
    pubDate: string;
    tags: string[];
}

const { url, title, description, pubDate, tags } = Astro.props;
---

<li class="blog-post">
    <a href={url}>{title}</a>
    <p class="date">{pubDate.toString().slice(0, 10)}</p>
    <p class="desc">{description}</p>
    {tags && (
        <ul class="tags">
            {tags.map((tag) => <li>{tag}</li>)}
        </ul>
    )}
</li>

<style>
    .blog-post {
        margin-bottom: 1.5rem;
        list-style: none;
    }

    .blog-post a {
        font-size: 1.1rem;
        font-weight: bold;
    }

    .date {
        font-size: 0.8rem;
        color: #888;
        margin-bottom: 0.25rem;
    }

    .desc {
        font-size: 0.9rem;
        color: #555;
        margin-bottom: 0.4rem;
    }

    .tags {
        display: flex;
        flex-wrap: wrap;
        gap: 0.4rem;
        list-style: none;
        padding: 0;
        margin: 0;
    }

    .tags li {
        background: #eef;
        color: #333;
        font-size: 0.75rem;
        padding: 2px 10px;
        border-radius: 99px;
        margin: 0;
    }
</style>
