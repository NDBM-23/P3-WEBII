---
import BaseLayout from "./BaseLayout.astro";

const { frontmatter } = Astro.props;
---

<BaseLayout pageTitle={frontmatter.title} description={frontmatter.description}>
    <article>
        <h1>{frontmatter.title}</h1>
        <p class="meta">
            <span>Por {frontmatter.author}</span>
            <span>{frontmatter.pubDate.toString().slice(0, 10)}</span>
        </p>
        <p><em>{frontmatter.description}</em></p>
        {frontmatter.image && (
            <img
                src={frontmatter.image.url}
                alt={frontmatter.image.alt}
                width="300"
            />
        )}
        <div class="content">
            <slot />
        </div>
        {frontmatter.tags && (
            <div class="tags">
                {frontmatter.tags.map((tag: string) => (
                    <a href={`/tags/${tag}`} class="tag">{tag}</a>
                ))}
            </div>
        )}
    </article>
</BaseLayout>

<style>
    .meta {
        display: flex;
        gap: 1.5rem;
        font-size: 0.875rem;
        color: #666;
        margin-bottom: 0.75rem;
    }

    .content {
        margin-top: 1.5rem;
    }

    .tags {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
        margin-top: 2rem;
    }

    .tag {
        border: dotted 1px #a1a1a1;
        border-radius: 0.5em;
        padding: 0.3em 0.9em;
        font-size: 0.85rem;
        background-color: #f8fcfd;
        text-decoration: none;
        color: #00539f;
    }

    .tag:hover {
        background-color: #e0f0ff;
    }
</style>
