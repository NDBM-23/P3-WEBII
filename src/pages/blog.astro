---
import BaseLayout from "../layouts/BaseLayout.astro";
import BlogPost from "../components/BlogPost.astro";

const pageTitle = "Mi Blog de Aprendizaje";
const author = "Nestor Becerra";

const allPosts = Object.values(
    import.meta.glob<{ frontmatter: { title: string; description: string; pubDate: string; tags: string[] }; url: string }>(
        "./posts/*.md",
        { eager: true }
    )
);

allPosts.sort((a, b) =>
    new Date(b.frontmatter.pubDate).getTime() - new Date(a.frontmatter.pubDate).getTime()
);
---

<BaseLayout pageTitle={`${pageTitle} - ${author}`}>
    <h1>{pageTitle}</h1>
    <p>
        Aquí compartiré mi experiencia aprendiendo Astro y mi camino por la
        carrera de Desarrollo de Software.
    </p>
    <ul style="padding: 0;">
        {allPosts.map((post) => (
            <BlogPost
                url={post.url}
                title={post.frontmatter.title}
                description={post.frontmatter.description}
                pubDate={post.frontmatter.pubDate}
                tags={post.frontmatter.tags}
            />
        ))}
    </ul>
</BaseLayout>
