---
import BaseLayout from "../layouts/BaseLayout.astro";

const pageTitle = "Mi Blog de Aprendizaje";
const author = "Nestor Becerra";

const posts = [
    {
        url: "/posts/post-1/",
        title: "Publicación 1: Cómo terminé en Desarrollo de Software en el CETI",
    },
    {
        url: "/posts/post-2/",
        title: "Publicación 2: Programación Web, mi Stack Actual y Astro",
    },
    {
        url: "/posts/post-3/",
        title: "Publicación 3: Sobreviviendo al CETI y mi futuro en Bajo Nivel",
    },
];
---

<BaseLayout pageTitle={`${pageTitle} - ${author}`}>
    <h1>{pageTitle}</h1>
    <p>
        Aquí compartiré mi experiencia aprendiendo Astro y mi camino por la
        carrera de Desarrollo de Software.
    </p>
    <ul>
        {
            posts.map((post) => (
                <li>
                    <a href={post.url}>{post.title}</a>
                </li>
            ))
        }
    </ul>
</BaseLayout>
