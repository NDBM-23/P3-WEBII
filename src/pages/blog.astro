---
import Navigation from "../components/Navigation.astro";
import Footer from "../components/Footer.astro";
import "../styles/global.css";

const pageTitle = "Mi Blog de Aprendizaje";
const author = "Nestor Becerra";

const posts = [
    {
        url: "/posts/post-1/",
        title: "Publicación 1: Cómo terminé en Desarrollo de Software en el CETI",
    },
    {
        url: "/posts/post-2/",
        title: "Publicación 2: Programación Web, mi Stack Actual y Astro",
    },
    {
        url: "/posts/post-3/",
        title: "Publicación 3: Sobreviviendo al CETI y mi futuro en Bajo Nivel",
    },
];

const primaryColor = "#333";
const maxWidth = "700px";
---

<html lang="es">
    <head>
        <meta charset="utf-8" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <link rel="icon" href="/favicon.ico" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <meta name="generator" content={Astro.generator} />
        <title>{pageTitle} - {author}</title>
        <style define:vars={{ primaryColor, maxWidth }}>
            * {
                box-sizing: border-box;
                margin: 0;
                padding: 0;
            }

            body {
                font-family: system-ui, sans-serif;
                color: var(--primaryColor);
                padding: 1.5rem;
            }

            nav {
                display: flex;
                justify-content: center;
                gap: 1.5rem;
                margin-bottom: 2.5rem;
            }

            main {
                max-width: var(--maxWidth);
                margin: 0 auto;
            }

            h1 {
                margin-bottom: 0.5rem;
            }

            p {
                margin-bottom: 1.5rem;
            }

            ul {
                padding-left: 1.2rem;
            }

            li {
                margin-bottom: 0.5rem;
            }

            a {
                color: var(--primaryColor);
            }
        </style>
    </head>
    <body>
        <Navigation />

        <main>
            <h1>{pageTitle}</h1>
            <p>
                Aquí compartiré mi experiencia aprendiendo Astro y mi camino por
                la carrera de Desarrollo de Software.
            </p>

            <ul>
                {
                    posts.map((post) => (
                        <li>
                            <a href={post.url}>{post.title}</a>
                        </li>
                    ))
                }
            </ul>
        </main>
        <Footer />
    </body>
</html>
