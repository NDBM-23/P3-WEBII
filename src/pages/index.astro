---
const pageTitle = "Inicio";
const name = "Nestor Becerra";
const role = "Estudiante de Desarrollo de Software en CETI Tecnólogo";

const primaryColor = "#333";
const maxWidth = "700px";
---

<html lang="es">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="generator" content={Astro.generator} />
		<title>{pageTitle} - {name}</title>
	</head>
	<body>
		<nav>
			<a href="/">Inicio</a>
			<a href="/about/">Sobre mí</a>
			<a href="/blog/">Blog</a>
		</nav>

		<main>
			<h1>{name}</h1>
			<p>{role}</p>
			<p>
				¡Bienvenido a mi sitio web personal, portafolio y blog de
				aprendizaje!
			</p>
		</main>

		<style define:vars={{ primaryColor, maxWidth }}>
			* {
				box-sizing: border-box;
				margin: 0;
				padding: 0;
			}

			body {
				font-family: system-ui, sans-serif;
				color: var(--primaryColor);
				padding: 1.5rem;
			}

			nav {
				display: flex;
				justify-content: center;
				gap: 1.5rem;
				margin-bottom: 2.5rem;
			}

			main {
				max-width: var(--maxWidth);
				margin: 0 auto;
			}

			h1 {
				margin-bottom: 0.5rem;
			}

			p {
				margin-bottom: 0.5rem;
			}

			a {
				color: var(--primaryColor);
			}
		</style>
	</body>
</html>
