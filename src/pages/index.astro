---
import BaseLayout from "../layouts/BaseLayout.astro";
import Greeting from "../components/Greeting";

const pageTitle = "Inicio";
const name = "Nestor Becerra";
const role = "Estudiante de Desarrollo de Software en CETI Tecnólogo";
---

<BaseLayout pageTitle={`${pageTitle} - ${name}`}>
    <h1>{name}</h1>
    <p>{role}</p>
    <p>¡Bienvenido a mi sitio web personal, portafolio y blog de aprendizaje!</p>
    <Greeting
        client:load
        messages={["Hola", "Hey", "¿Qué tal?", "Bienvenido", "¡Buenas!"]}
    />
</BaseLayout>
