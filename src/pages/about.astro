---
import "../styles/global.css";

const pageTitle = "Sobre mí";

const identity = {
    firstName: "Nestor",
    lastName: "Becerra",
    country: "México",
    school: "CETI Tecnólogo",
    occupation: "Estudiante de Desarrollo de Software",
    hobbies: ["matemáticas y ciencias", "programación", "explorar tecnología"],
};

const skills = [
    "HTML",
    "JavaScript / React",
    "API REST",
    "GraphQL",
    "Astro",
    "Git / Control de versiones",
];

const targetRole = "Programación de bajo nivel";

const happy = true;
const finished = false;
const goal = 3;

const primaryColor = "#333";
const maxWidth = "700px";
---

<html lang="es">
    <head>
        <meta charset="utf-8" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <link rel="icon" href="/favicon.ico" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <meta name="generator" content={Astro.generator} />
        <title>{pageTitle} - {identity.firstName} {identity.lastName}</title>
    </head>
    <body>
        <nav>
            <a href="/">Inicio</a>
            <a href="/about/">Sobre mí</a>
            <a href="/blog/">Blog</a>
        </nav>

        <main>
            <section id="about-me">
                <header>
                    <div>
                        <h1>{identity.firstName} {identity.lastName}</h1>
                        <p>{identity.occupation}</p>
                    </div>
                </header>

                <article>
                    <h2>Biografía</h2>
                    <p>
                        ¡Hola! Soy estudiante en {identity.school} ({
                            identity.country
                        }). Aunque originalmente planeaba entrar a
                        Electromecánica, terminé en Desarrollo de Software y
                        descubrí lo emocionante que es crear código que funcione
                        en el mundo real.
                    </p>
                    <p>
                        La exigencia del CETI me ha enseñado a resolver
                        problemas complejos bajo presión. Al egresar, mi meta
                        principal es dedicarme a la {targetRole}.
                    </p>

                    {happy && <p>¡Estoy feliz de estar aprendiendo Astro!</p>}
                    {finished && <p>¡He terminado este tutorial!</p>}
                    {
                        goal === 3 ? (
                            <p>Mi meta es terminar en 90 min.</p>
                        ) : (
                            <p>Mi meta no es de 90 min.</p>
                        )
                    }
                </article>

                <article>
                    <h2>Habilidades Técnicas</h2>
                    <ul>
                        {skills.map((skill) => <li>{skill}</li>)}
                    </ul>
                </article>

                <article>
                    <h2>Contacto y Enlaces</h2>
                    <ul>
                        <li>
                            Correo: <a href="mailto:tu.correo@ejemplo.com"
                                >tu.correo@ejemplo.com</a
                            >
                        </li>
                        <li>
                            GitHub: <a
                                href="https://github.com/tuusuario"
                                target="_blank"
                                rel="noopener noreferrer"
                                >github.com/tuusuario</a
                            >
                        </li>
                        <li>
                            LinkedIn: <a
                                href="https://linkedin.com/in/tuusuario"
                                target="_blank"
                                rel="noopener noreferrer"
                                >linkedin.com/in/tuusuario</a
                            >
                        </li>
                    </ul>
                </article>
            </section>
        </main>

        <style define:vars={{ primaryColor, maxWidth }}>
            * {
                box-sizing: border-box;
                margin: 0;
                padding: 0;
            }

            body {
                font-family: system-ui, sans-serif;
                color: var(--primaryColor);
                padding: 1.5rem;
            }

            nav {
                display: flex;
                justify-content: center;
                gap: 1.5rem;
                margin-bottom: 2.5rem;
            }

            main {
                max-width: var(--maxWidth);
                margin: 0 auto;
            }

            header {
                display: flex;
                align-items: center;
                gap: 1.5rem;
                margin-bottom: 2rem;
            }

            article {
                margin-bottom: 2rem;
            }

            h1,
            h2 {
                margin-bottom: 0.5rem;
            }

            p {
                margin-bottom: 0.5rem;
            }

            ul {
                padding-left: 1.2rem;
            }

            li {
                margin-bottom: 0.25rem;
            }

            a {
                color: var(--primaryColor);
            }
        </style>
    </body>
</html>
